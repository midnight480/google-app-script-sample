{
  "enabled": true,
  "name": "Sync Agent Rules",
  "description": "AGENTS.md（マスター）が編集されたとき、他のエージェント向け定義ファイルを同期します。CLAUDE.md と GEMINI.md は AGENTS.md を参照するポインタ、.cursorrules / .clinerules / .antigravity/rules.md / .github/copilot-instructions.md は全文の複製として生成されます。",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "AGENTS.md"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "./scripts/sync-agent-rules.sh"
  }
}
